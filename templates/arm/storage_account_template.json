{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Deploy Azure Storage Account - Static Template Example",
    "author": "Azure Infrastructure Agent"
  },
  "parameters": {
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Name of the storage account"
      },
      "minLength": 3,
      "maxLength": 24
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "performanceTier": {
      "type": "string",
      "defaultValue": "Standard",
      "allowedValues": [
        "Standard",
        "Premium"
      ],
      "metadata": {
        "description": "Performance tier of the storage account"
      }
    },
    "replicationType": {
      "type": "string",
      "defaultValue": "LRS",
      "allowedValues": [
        "LRS",
        "GRS",
        "RAGRS", 
        "ZRS",
        "GZRS",
        "RAGZRS"
      ],
      "metadata": {
        "description": "Replication type for the storage account"
      }
    },
    "accessTier": {
      "type": "string",
      "defaultValue": "Hot",
      "allowedValues": [
        "Hot",
        "Cool",
        "Archive"
      ],
      "metadata": {
        "description": "Access tier for blob storage"
      }
    },
    "storageAccountKind": {
      "type": "string",
      "defaultValue": "StorageV2",
      "allowedValues": [
        "Storage",
        "StorageV2",
        "BlobStorage",
        "FileStorage",
        "BlockBlobStorage"
      ],
      "metadata": {
        "description": "Kind of storage account"
      }
    },
    "enableHttpsOnly": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable HTTPS traffic only"
      }
    },
    "enableHierarchicalNamespace": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable hierarchical namespace for Data Lake Gen2"
      }
    }
  },
  "variables": {
    "storageAccountType": "[concat(parameters('performanceTier'), '_', parameters('replicationType'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[variables('storageAccountType')]"
      },
      "kind": "[parameters('storageAccountKind')]",
      "properties": {
        "accessTier": "[parameters('accessTier')]",
        "supportsHttpsTrafficOnly": "[parameters('enableHttpsOnly')]",
        "isHnsEnabled": "[parameters('enableHierarchicalNamespace')]",
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "networkAcls": {
          "defaultAction": "Allow"
        },
        "encryption": {
          "services": {
            "blob": {
              "enabled": true,
              "keyType": "Account"
            },
            "file": {
              "enabled": true,
              "keyType": "Account"
            }
          },
          "keySource": "Microsoft.Storage"
        }
      }
    }
  ],
  "outputs": {
    "storageAccountName": {
      "type": "string",
      "value": "[parameters('storageAccountName')]",
      "metadata": {
        "description": "Name of the created storage account"
      }
    },
    "storageAccountId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
      "metadata": {
        "description": "Resource ID of the storage account"
      }
    },
    "primaryEndpoints": {
      "type": "object",
      "value": "[reference(parameters('storageAccountName')).primaryEndpoints]",
      "metadata": {
        "description": "Primary endpoints for the storage account"
      }
    },
    "storageAccountKeys": {
      "type": "object",
      "value": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-01-01')]",
      "metadata": {
        "description": "Storage account access keys"
      }
    }
  }
}